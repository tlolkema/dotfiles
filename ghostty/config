# Appearance
font-size = 16
macos-titlebar-style = tabs
mouse-hide-while-typing = true
theme = Embark 
title = " "
window-padding-x = 15,15

# Keybinds
keybind = cmd+left=text:\x1b[1;5D
keybind = cmd+right=text:\x1b[1;5C
keybind = cmd+up=text:\x1b[1;5A
keybind = cmd+down=text:\x1b[1;5B
keybind = shift+enter=text:\n
